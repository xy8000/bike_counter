# Created by https://www.toptal.com/developers/gitignore/api/rust,visualstudiocode,git
# Edit at https://www.toptal.com/developers/gitignore?templates=rust,visualstudiocode,git

### Git ###
# Created by git for backups. To disable backups in Git:
# $ git config --global mergetool.keepBackup false
*.orig

# Created by git when using merge tools for conflicts
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock IS tracked: this is an executable (binary) crate and the backend
# Dockerfile copies Cargo.lock, so it must be present in a fresh checkout.

# These are backup files generated by rustfmt
**/*.rs.bk

# Coverage reports (cargo-llvm-cov); llvm-cov also writes into target/ which is ignored above
*.profraw
lcov.info
coverage/

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

### Configuration ###
config.toml

### Frontend ###
# Node modules and the production bundle are never committed.
frontend/node_modules/
frontend/dist/

# Playwright test artifacts (results, reports, traces).
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# Local sample data (large upstream archive, not part of the build).
example

### Map tiles ###
# Self-hosted PMTiles basemap archive (large, extracted once; see tiles/README.md).
tiles/*.pmtiles
# Cached go-pmtiles CLI downloaded by the backend (see backend/src/adapter/driven/tiles_init/).
tiles/.pmtiles-bin/

# End of https://www.toptal.com/developers/gitignore/api/rust,visualstudiocode,git