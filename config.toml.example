database_url="postgres://db:5432"
database_user="postgres"
database_password="postgres"
database_name="bike_counter"

# Whether the scheduled background jobs (data-source update, asset cleanup,
# tiles update) run at all. Defaults to true (omitting the key keeps the jobs
# enabled); set to false for test/e2e setups that must never reach the
# providers.
scheduled_jobs_enabled = true

# CRON expression for the data-source update job (default: once a day at 03:00,
# i.e. just before the daily OpenData export so the export sees the previous
# day's freshly imported data).
data_source_update_cron="0 0 3 * * *"
# REQUIRED max heartbeat interval for the update job in seconds (no default).
# While a job runs, a dedicated loop refreshes it every few seconds, so a few
# minutes is plenty — a worker silent for longer than this is treated as dead
# and its lock is reclaimed (this bounds crash-recovery latency).
data_source_update_max_heartbeat_interval_seconds=300

# CRON expression for the asset cleanup job (default: daily at 04:00).
asset_cleanup_cron="0 0 4 * * *"
# REQUIRED max heartbeat interval for the asset cleanup job in seconds (no
# default); same semantics and guidance as the data-source update interval.
asset_cleanup_max_heartbeat_interval_seconds=300

# OpenData export job: publishes the immutable daily/monthly measurement files
# (parquet / csv.gz / json) under /api/v1/opendata.
[opendata]
# CRON expression for the export job (default: daily at 03:30, after the
# previous day's data has landed from every provider).
export_cron = "0 30 3 * * *"
# Max heartbeat interval for the export job in seconds (default: 600).
export_max_heartbeat_interval_seconds = 600

# Dedicated bucket on the same MinIO server holding the immutable opendata files
# (kept separate from the station-image bucket).
[opendata_storage]
endpoint = "http://minio:9000"
access_key = "minioadmin"
secret_key = "minioadmin"
bucket = "bike-counter-opendata"
region = "us-east-1"

# S3-compatible object storage (MinIO) holding counting-station image binaries.
# PostgreSQL stores only the metadata; the BFF streams the content to browsers.
[asset_storage]
endpoint = "http://minio:9000"
access_key = "minioadmin"
secret_key = "minioadmin"
bucket = "bike-counter-images"
region = "us-east-1"

# Self-hosted vector basemap ("maps") configuration. The basemap is built by the
# backend at startup (mandatory) and refreshed by a cron-scheduled `tiles_update`
# job, which swaps the archive atomically so the running app stays online.
[maps]
# CRON expression for the basemap refresh (default: every two months, 1st at 03:00).
update_cron = "0 0 3 1 1,3,5,7,9,11 *"
# Max heartbeat interval for the tiles update job in seconds (default: 2 hours).
update_max_heartbeat_interval_seconds = 7200
# Pinned Protomaps daily build (see maps.protomaps.com/builds). Bump periodically.
protomaps_build_url = "https://build.protomaps.com/20260905.pmtiles"
# Pinned go-pmtiles CLI version used to extract/merge the basemap.
go_pmtiles_version = "1.31.2"

[[data_sources]]
name = "Münster"

[data_sources.provider]
type = "münster_opendata_github_provider"
# Minimum provider-message severity to persist (default: WARNING).
log_level = "WARNING"

[data_sources.provider.vars]
url = "https://github.com/od-ms/radverkehr-zaehlstellen/archive/refs/heads/main.zip"
max_measurement_batch_size = "500"
# Import time window per provider call, in hours (default 7 days = 168).
max_measurement_timeframe_hours = "168"

[[data_sources]]
name = "Bonn"

[data_sources.provider]
type = "bonn_opendata_http_provider"
# Minimum provider-message severity to persist (default: WARNING).
log_level = "WARNING"

[data_sources.provider.vars]
# Official station locations (GeoJSON: station_nr + lage + coordinates).
stations_url = "https://stadtplan.bonn.de/geojson?Thema=22640"
# Official previous-day measurements (Vortag CSV, hourly, `wann` is UTC).
measurements_url = "https://stadtplan.bonn.de/csv?OD=4285"
# Optional historical hourly backfill (2023-2025, wide yearly CSVs), space-separated.
# The first import serves this backfill plus the rolling Vortag data; the
# `imported_until` watermark then keeps only the current data flowing.
historical_urls = "https://opendata.bonn.de/sites/default/files/Fahrradzaehlstellen2023_stuendlich.csv https://opendata.bonn.de/sites/default/files/MessergebnisseFahrradzaehlstationenStundenauswertung2024.csv https://opendata.bonn.de/sites/default/files/fahrradzaehldatenbonn2025.csv"
max_measurement_batch_size = "500"
# Cache window for the fetched resources, in seconds (default 300).
cache_duration = "300"

[[data_sources]]
name = "Hamburg"

[data_sources.provider]
type = "hamburg_sta_http_provider"
# Minimum provider-message severity to persist (default: WARNING).
log_level = "WARNING"

[data_sources.provider.vars]
# Official Hamburg SensorThings API (dataset HH_STA_Verkehrsdaten_Rad_Infrarotdetektoren).
# Stations = MQ (knotenName), channels = Zählfeld (directional counting fields).
base_url = "https://iot.hamburg.de/v1.0/"
# Rows kept per source-level batch; must be >= the $top page size (1000) so a
# fetched page is never truncated and re-fetched.
max_measurement_batch_size = "1000"
# Cache window for the discovery index, in seconds (default 300).
cache_duration = "300"
# Merge the legacy "(veraltet)" field 5-min series for history (default true).
include_legacy = "true"
# Fields paged in parallel per batch (default 8). Lower to be gentler on the API.
concurrency = "8"

[[data_sources]]
name = "Leipzig"

[data_sources.provider]
type = "leipzig_wfs_http_provider"
# Minimum provider-message severity to persist (default: WARNING).
log_level = "WARNING"

[data_sources.provider.vars]
# Official Leipzig WFS layers (geodienste.leipzig.de, GeoServer, GeoJSON output).
# Station coordinates are ETRS89 / UTM zone 33N; the adapter converts them to
# WGS84 in code. Measurement `phenomenontime` carries the counted interval start.
# Stations (static locations).
stations_url = "https://geodienste.leipzig.de/l3/OpenData/wfs?service=WFS&version=2.0.0&request=GetFeature&typeName=OpenData%3Aradverkehr_dauerzaehlstelle_standort_statisch&outputFormat=application%2Fjson"
# Hourly counts (3600 s resolution; phenomenontime is RFC 3339 with UTC offset).
hourly_url = "https://geodienste.leipzig.de/l3/OpenData/wfs?service=WFS&version=2.0.0&request=GetFeature&typeName=OpenData%3Aradverkehr_dauerzaehlstelle_anzahl_stunde_zeitreihe&outputFormat=application%2Fjson"
# Daily counts (86400 s, calendar-anchored Europe/Berlin; phenomenontime is a date).
daily_url = "https://geodienste.leipzig.de/l3/OpenData/wfs?service=WFS&version=2.0.0&request=GetFeature&typeName=OpenData%3Aradverkehr_dauerzaehlstelle_anzahl_tag_zeitreihe&outputFormat=application%2Fjson"
max_measurement_batch_size = "500"
# Cache window for the parsed index, in seconds (default 300).
cache_duration = "300"
# WFS `count` per page when fetching the time-series layers (default 5000).
wfs_page_size = "5000"

[[data_sources]]
name = "Eco-Counter"

[data_sources.provider]
type = "eco_counter_v1_http_provider"
# Minimum provider-message severity to persist (default: WARNING).
log_level = "WARNING"

[data_sources.provider.vars]
# Eco-Counter is imported through three SEPARATE provider types — one
# [[data_sources]] entry per version (there is no `modes` var anymore):
#   eco_counter_v1_http_provider  legacy public Eco-Visio API + bundled
#                                 v1/stations.yml catalog (this example)
#   eco_counter_v2_http_provider  official API (apieco.eco-counter-tools.com)
#                                 with an organisation access token (see below)
#   eco_counter_web_http_provider public-web-view scraper of a
#                                 *.eco-counter.com dashboard, daily only, one
#                                 tenant per data source (see below)
# Each provider reads plain (unprefixed) vars from its own data source.
#
# Public legacy Eco-Visio API (eco_counter_v1_http_provider). Stations are NOT
# configured here: the counters to import live in the bundled
# backend/src/adapter/driven/eco_counter/v1/stations.yml catalog (the upstream
# no longer auto-discovers German tenants on this API).
base_url = "https://www.eco-visio.net/api/aladdin/1.0.0"
# Resolution is auto-detected per counter: 15 min when available, else hourly,
# else daily (no `step` var).
# Rows kept per source-level batch (default 500).
max_measurement_batch_size = "500"
# Cache window for the resolved station index, in seconds (default 300).
cache_duration = "300"
# Day window requested per HTTP call (default 7).
page_days = "7"
# Initial lookback without an imported_until watermark, in days (default 365).
import_days_back = "365"

# …or use the official Eco-Counter API (eco_counter_v2_http_provider), which
# discovers an organisation's sites at runtime with an access token:
# [[data_sources]]
# name = "Eco-Counter V2"
# [data_sources.provider]
# type = "eco_counter_v2_http_provider"
# log_level = "WARNING"
# [data_sources.provider.vars]
# # The organisation's OAuth access token (required; Authorization: Bearer).
# access_token = "<organisation access token>"
# # Optional: restrict discovery to one domain (`/site?domain_id=`).
# domain_id = "4701"
# # Data resolution: 2 = 15 min, 3 = hourly, 4 = daily (default 3).
# step = "3"
# # Official API root (default below).
# # base_url = "https://apieco.eco-counter-tools.com/api/1.0"
# max_measurement_batch_size = "500"
# cache_duration = "300"
# page_days = "7"
# import_days_back = "365"

# …or scrape a public Eco-Counter dashboard that has no usable API
# (eco_counter_web_http_provider). Screen scraping runs ONE tenant per data
# source: add one [[data_sources]] per root URL.
# [[data_sources]]
# name = "Hessen Mobil"
# [data_sources.provider]
# type = "eco_counter_web_http_provider"
# log_level = "WARNING"
# [data_sources.provider.vars]
# # The tenant root page (required).
# scrape_url = "https://hessen-mobil.eco-counter.com"
# # Requests to the dashboard per second (default 1). Resolution is daily only.
# rate_limit_requests_per_second = "1"
# # IANA timezone of the station daily series (default Europe/Berlin).
# timezone = "Europe/Berlin"
# # Cache window for the scraped station list, in seconds (default 300).
# cache_duration = "300"
# # Initial lookback without an imported_until watermark, in days (default 365).
# import_days_back = "365"
