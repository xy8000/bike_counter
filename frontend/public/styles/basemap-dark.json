{
  "version": 8,
  "name": "Bike counter basemap dark (Protomaps basemap, self-hosted PMTiles)",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles://REPLACED_AT_RUNTIME/tiles/map.pmtiles",
      "attribution": "© OpenStreetMap contributors, © Protomaps"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#1b1b1f"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#1b1b1f"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#2a2d26"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#26262b"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#274a66"
      }
    },
    {
      "id": "water_stream",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "minzoom": 14,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "stream"
      ],
      "paint": {
        "line-color": "#274a66",
        "line-width": 0.5
      }
    },
    {
      "id": "water_river",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "river"
      ],
      "paint": {
        "line-color": "#274a66",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.5,
          12,
          1.0,
          15,
          2.0
        ]
      }
    },
    {
      "id": "water_canal",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "canal"
      ],
      "paint": {
        "line-color": "#274a66",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.5,
          15,
          2.0
        ]
      }
    },
    {
      "id": "water_other",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "ditch"
        ],
        [
          "==",
          [
            "get",
            "kind"
          ],
          "drain"
        ]
      ],
      "paint": {
        "line-color": "#274a66",
        "line-width": 0.5
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "paint": {
        "line-color": "#3c3c42",
        "line-width": 1.2
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#4a4a50",
        "line-width": 1
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#35323a"
      }
    },
    {
      "id": "country_labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 2,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "country"
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2,
          11,
          5,
          14,
          8,
          17
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#d5d5dc",
        "text-halo-color": "#1b1b1f",
        "text-halo-width": 2
      }
    },
    {
      "id": "city_labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 6,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "locality"
        ],
        [
          "==",
          [
            "get",
            "kind_detail"
          ],
          "city"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          14,
          10,
          17,
          14,
          20,
          18,
          22
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#e0e0e8",
        "text-halo-color": "#1b1b1f",
        "text-halo-width": 2
      }
    },
    {
      "id": "town_labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "locality"
        ],
        [
          "==",
          [
            "get",
            "kind_detail"
          ],
          "town"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          11,
          13,
          13,
          16,
          15,
          18,
          16
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#c9c9d2",
        "text-halo-color": "#1b1b1f",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "village_labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "locality"
        ],
        [
          "==",
          [
            "get",
            "kind_detail"
          ],
          "village"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          9,
          15,
          11,
          18,
          13
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#b8b8c2",
        "text-halo-color": "#1b1b1f",
        "text-halo-width": 1
      }
    },
    {
      "id": "district_labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 12,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "neighbourhood"
        ],
        [
          "all",
          [
            "==",
            [
              "get",
              "kind"
            ],
            "macrohood"
          ],
          [
            "==",
            [
              "get",
              "kind_detail"
            ],
            "neighbourhood"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          10,
          15,
          12,
          18,
          14
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#a8a8b2",
        "text-halo-color": "#1b1b1f",
        "text-halo-width": 1
      }
    },
    {
      "id": "road_labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          9,
          15,
          11,
          18,
          13
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#c0c0ca",
        "text-halo-color": "#1b1b1f",
        "text-halo-width": 1.5
      }
    }
  ]
}
